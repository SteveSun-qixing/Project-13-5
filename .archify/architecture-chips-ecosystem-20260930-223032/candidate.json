  "cards": [
    {
      "dot": "cyan",
      "title": "插件生态",
      "items": [
        "插件类型：app / card / layout / module（theme 为 Host 内部保留，不再对外开放）",
        "插件以独立仓库、独立软件产品形态发布，可单独成为应用入口",
        "插件只能经 window.chips.* 访问系统能力，禁止直连平台 API"
      ]
    },
    {
      "dot": "emerald",
      "title": "Host 运行时",
      "items": [
        "内核路由以 namespace.action 统一分发，调用即做 schema 校验、权限判定与超时/熔断/重放防护",
        "服务域覆盖 file · resource · config · window · plugin · module · card · box · zip · serializer · control-plane 等",
        "插件运行时负责清单校验、插件会话握手、权限与消息配额；窗口经 PAL 创建"
      ]
    },
    {
      "dot": "violet",
      "title": "共享开发层",
      "items": [
        "chips-sdk 只提供类型化封装、脚手架与测试辅助，不承载 Host 运行时主实现",
        "@chips/ui 与 antd 统一视觉（appleTheme + global.css），界面文案简体中文直写"
      ]
    },
    {
      "dot": "amber",
      "title": "服务器侧",
      "items": [
        "社区平台服务器与个人服务器均基于 Fastify + PostgreSQL（drizzle-orm）+ S3/MinIO",
        "社区 Web 前端为 Vite SPA，浏览器直接加载渲染产物",
        "客户端经 module.invoke 调用 community.card.transfer 上传与下载卡片"
      ]
    }
  ]
}
